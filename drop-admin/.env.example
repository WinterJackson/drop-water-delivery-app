# Clerk — the SAME application the three mobile apps use, so an admin who is
# also a vendor is one identity.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Deliberately NOT prefixed NEXT_PUBLIC_. The browser never calls FastAPI
# directly — every request goes through this app's server, which attaches the
# token. Prefixing it would invite someone to call the API from the client and
# hand the token to the browser along with it.
BACKEND_BASE_URL=http://localhost:8000

# Google Maps JavaScript API, for /operations/map. This one IS public — the
# browser is what draws the map — so it must be restricted in the Google Cloud
# console, on this key alone:
#
#   Application restrictions → Websites:
#       http://localhost:3000/*
#       https://drop-admin-five.vercel.app/*
#   API restrictions → Maps JavaScript API   (nothing else)
#
# It is an SDK key, the same arrangement as the mobile apps' package-restricted
# keys — not a web-service key. Directions, Places and Geocoding stay behind
# BackendAPI/routes/maps_routes.py with the IP-restricted server key, and this
# key must not be granted them: an unrestricted browser key lifted from this
# page is billed to the project.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=AIza...
