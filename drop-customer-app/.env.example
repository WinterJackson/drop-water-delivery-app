# drop-customer-app — environment
#
# Copy to `.env` and fill in. `.env` is gitignored (root .gitignore, `**/.env`).
#
# EXPO_PUBLIC_* is inlined into the JS bundle at build time and is readable by
# anyone with the .ipa/.apk. Nothing secret goes in one — no API secret, no
# private key. Server-side credentials (M-Pesa, Clerk secret key, AWS) live only
# in BackendAPI/.env; see docs/render-environment.md.

# ── Backend ───────────────────────────────────────────────────────────────
# 10.0.2.2 is the Android emulator's alias for the host machine's localhost.
#   iOS simulator .............. http://localhost:8000
#   Physical device on wifi .... http://<your-LAN-IP>:8000
#   Deployed ................... https://vepo-backend.onrender.com
EXPO_PUBLIC_BACKEND_BASE_URL="http://10.0.2.2:8000"

# Live order tracking sockets. Same host as above with the scheme swapped
# (ws:// for http://, wss:// for https://). If unset the app derives it from
# EXPO_PUBLIC_BACKEND_BASE_URL, which is correct — set it explicitly so the
# socket endpoint can be pointed elsewhere independently.
EXPO_PUBLIC_WS_BASE_URL="ws://10.0.2.2:8000"

# ── Clerk ─────────────────────────────────────────────────────────────────
# The *publishable* key (pk_test_… / pk_live_…). The secret key belongs on the
# API only. Must be the same Clerk instance the backend validates against, or
# every request 401s — CLERK_ISSUER / CLERK_JWKS_URL there must match this.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."

# ── Google Maps (native SDK keys) ─────────────────────────────────────────
# Read by app.config.js, not by application code. Restrict each key in Google
# Cloud to the Maps SDK for this package/bundle only — that restriction is what
# makes an embedded key safe. It also means these keys cannot call Directions,
# Places or Geocoding; those go through the backend (routes/maps_routes.py).
GOOGLE_MAPS_ANDROID_API_KEY="AIza..."
GOOGLE_MAPS_IOS_API_KEY="AIza..."

# ── Cloudinary (image uploads) ────────────────────────────────────────────
# Unsigned upload preset — safe to ship, it can only create, not read or delete.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME="dn5f0jksu"
EXPO_PUBLIC_CLOUDINARY_PRESET="drop_uploads"

# ── Sentry ────────────────────────────────────────────────────────────────
# Optional. Crash reporting is skipped when empty.
EXPO_PUBLIC_SENTRY_DSN=""

# ── Not set here ──────────────────────────────────────────────────────────
# GOOGLE_SERVICES_JSON is an EAS *file* secret, not a local variable. It is the
# path EAS materialises google-services.json at during a build; locally
# app.config.js falls back to ./google-services.json. Android push in a
# standalone build needs it. See docs/push-notifications.md.
